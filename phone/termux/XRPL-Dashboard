#!/data/data/com.termux/files/usr/bin/bash
# Private dashboard: an encrypted SSH tunnel to the server, then Chrome.
SERVER=botadmin@157.245.255.65
FWD=8080:127.0.0.1:8080
echo "Opening a private, encrypted tunnel to the dashboard."
pkill -f -- "-L $FWD" 2>/dev/null   # close any tunnel left open earlier
# -f: ssh goes to the background only AFTER you've logged in and the tunnel
# works, so Chrome never opens over the passphrase prompt.
if ! ssh -f -N -L "$FWD" -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 "$SERVER"; then
    echo "Couldn't open the tunnel (wrong passphrase or no connection). Try again."
    read -n 1 -s -r -p "Tap any key to close"
    exit 1
fi
code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' http://localhost:8080/login)
if [ "$code" != "200" ]; then
    echo
    echo "The tunnel works, but the dashboard on the server isn't answering (got: ${code:-nothing})."
    echo "It may be restarting. Its recent log:"
    ssh "$SERVER" "sudo journalctl -u xrplarb-dashboard -n 15 --no-pager -o cat"
    pkill -f -- "-L $FWD"
    read -n 1 -s -r -p "Send Claude a screenshot of this. Tap any key to close"
    exit 1
fi
echo "Tunnel is up and the dashboard answers. Opening Chrome at http://localhost:8080 ..."
termux-open-url http://localhost:8080
echo
echo "Use the dashboard in Chrome. The tunnel stays open until you close it here."
while true; do
    read -r -p "Type close and press Enter when you're finished: " answer || sleep 5
    [ "$answer" = "close" ] && break
done
pkill -f -- "-L $FWD"
echo "Tunnel closed."
